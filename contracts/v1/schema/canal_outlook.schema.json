{
  "$defs": {
    "CanalFactor": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Time of the data the factor uses",
          "title": "At"
        },
        "kind": {
          "description": "inflow: water let into the canal network (RID's gates); rain: rain forecast over its districts; drainage: the state of the river it drains to; level: Bangkok's gauges on it rising; flooding: RID's report of flooded districts along it",
          "enum": [
            "inflow",
            "rain",
            "drainage",
            "level",
            "flooding"
          ],
          "title": "Kind",
          "type": "string"
        },
        "points": {
          "description": "What this factor adds to the canal's score (0 = noted, no points)",
          "maximum": 2,
          "minimum": 0,
          "title": "Points",
          "type": "integer"
        },
        "source_th": {
          "title": "Source Th",
          "type": "string"
        },
        "text_th": {
          "title": "Text Th",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "points",
        "text_th",
        "source_th",
        "at"
      ],
      "title": "CanalFactor",
      "type": "object"
    },
    "CanalGap": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "A factor that applies to the canal but could not be judged",
          "enum": [
            "inflow",
            "rain",
            "drainage",
            "level",
            "flooding"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text_th": {
          "description": "Why, e.g. ไม่มีพยากรณ์ฝนที่ใหม่พอ",
          "title": "Text Th",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text_th"
      ],
      "title": "CanalGap",
      "type": "object"
    },
    "CanalInput": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The time of the data (RID's 06:00, the forecast's fetch, the Bangkok file's fetch); null when missing",
          "title": "At"
        },
        "name_th": {
          "title": "Name Th",
          "type": "string"
        },
        "source": {
          "description": "flows: water/flows.json (RID); rain: forecast/rain.json; levels: bkk/water.json (Bangkok's gauges)",
          "enum": [
            "flows",
            "rain",
            "levels"
          ],
          "title": "Source",
          "type": "string"
        },
        "status": {
          "description": "fresh: used; stale: older than the rules allow, not used; missing: not in the round or unreadable",
          "enum": [
            "fresh",
            "stale",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source",
        "name_th",
        "status",
        "at"
      ],
      "title": "CanalInput",
      "type": "object"
    },
    "CanalWatch": {
      "additionalProperties": false,
      "properties": {
        "assessed": {
          "default": true,
          "description": "False when no factor that applies to the canal had data fresh enough: its score and level then say nothing, and it is shown as not assessed, never as below the rules (M50)",
          "title": "Assessed",
          "type": "boolean"
        },
        "factors": {
          "items": {
            "$ref": "#/$defs/CanalFactor"
          },
          "title": "Factors",
          "type": "array"
        },
        "gaps": {
          "description": "The factors that apply to the canal but could not be judged, with why; the score counts only the others",
          "items": {
            "$ref": "#/$defs/CanalGap"
          },
          "title": "Gaps",
          "type": "array"
        },
        "id": {
          "description": "The canal's id in ref/canals.json",
          "title": "Id",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "enum": [
                "watch",
                "warn"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "warn (score 3 or more) or watch (2) by this site's trial rules; null below. Not an announcement and not a forecast of how high the water will be",
          "title": "Level"
        },
        "name_th": {
          "title": "Name Th",
          "type": "string"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name_th",
        "score",
        "level",
        "factors"
      ],
      "title": "CanalWatch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "canals": {
      "description": "Every canal of ref/canals.json, the highest score first",
      "items": {
        "$ref": "#/$defs/CanalWatch"
      },
      "title": "Canals",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "inputs": {
      "description": "What each source was when this was made",
      "items": {
        "$ref": "#/$defs/CanalInput"
      },
      "title": "Inputs",
      "type": "array"
    },
    "notes_th": {
      "items": {
        "type": "string"
      },
      "title": "Notes Th",
      "type": "array"
    },
    "rules": {
      "description": "Version of the trial rules, e.g. canals-v1",
      "title": "Rules",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "generated_at",
    "rules",
    "canals",
    "notes_th"
  ],
  "title": "CanalOutlook",
  "type": "object"
}
