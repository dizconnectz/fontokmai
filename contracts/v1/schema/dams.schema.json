{
  "$defs": {
    "Dam": {
      "additionalProperties": false,
      "properties": {
        "downstream_th": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provinces the dam's river runs through, down to the sea or out of Thailand, e.g. ท้ายน้ำ: นครนายก → ปราจีนบุรี → ฉะเชิงเทรา · ออกทะเลที่ อ.บางปะกง จ.ฉะเชิงเทรา (HydroRIVERS river network); places to follow when the dam releases water, not a flood forecast. Null when the dam has no place or river",
          "title": "Downstream Th"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "inflow_mcm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inflow of the day, million cubic metres",
          "title": "Inflow Mcm"
        },
        "last_known": {
          "anyOf": [
            {
              "$ref": "#/$defs/DamFigures"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only when this report has none of percent, volume_mcm, inflow_mcm and outflow_mcm for the dam: its latest figures from an earlier report this site published, at most 7 days before report_date, with their own day and fetch time. Shown dated, never as this report's (user 2026-10-01: the department's report of a day can be blank for most dams until later in the day)"
        },
        "location": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "[lon, lat] from OpenStreetMap; null when not found",
          "title": "Location"
        },
        "location_kind": {
          "anyOf": [
            {
              "enum": [
                "dam",
                "reservoir"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "dam = on the dam wall, reservoir = the middle of its lake (used when the wall is not mapped)",
          "title": "Location Kind"
        },
        "name_th": {
          "title": "Name Th",
          "type": "string"
        },
        "outflow_mcm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Release of the day, million cubic metres",
          "title": "Outflow Mcm"
        },
        "owner_th": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner Th"
        },
        "percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "volume as a percentage of storage",
          "title": "Percent"
        },
        "previous_outflow_mcm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Release on previous_report_date of the file, million cubic metres; null when there is no earlier report or the dam had no figure then. Release up a lot (the site's trial rule, /method): at least 1 million m³ a day more and at least half as much again",
          "title": "Previous Outflow Mcm"
        },
        "region_th": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Region Th"
        },
        "storage_mcm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Capacity at normal storage level, million cubic metres",
          "title": "Storage Mcm"
        },
        "volume_mcm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Water in the reservoir on the report day, million cubic metres",
          "title": "Volume Mcm"
        }
      },
      "required": [
        "id",
        "name_th",
        "region_th",
        "owner_th",
        "location",
        "location_kind",
        "storage_mcm",
        "volume_mcm",
        "percent",
        "inflow_mcm",
        "outflow_mcm"
      ],
      "title": "Dam",
      "type": "object"
    },
    "DamFigures": {
      "additionalProperties": false,
      "properties": {
        "fetched_at": {
          "description": "When this site fetched that report",
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "inflow_mcm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inflow Mcm"
        },
        "outflow_mcm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outflow Mcm"
        },
        "percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Percent"
        },
        "report_date": {
          "description": "Day of the department's report these figures are from",
          "format": "date",
          "title": "Report Date",
          "type": "string"
        },
        "volume_mcm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Volume Mcm"
        }
      },
      "required": [
        "report_date",
        "fetched_at",
        "percent",
        "volume_mcm",
        "inflow_mcm",
        "outflow_mcm"
      ],
      "title": "DamFigures",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "credit_th": {
      "title": "Credit Th",
      "type": "string"
    },
    "dams": {
      "items": {
        "$ref": "#/$defs/Dam"
      },
      "title": "Dams",
      "type": "array"
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "location_credit_th": {
      "title": "Location Credit Th",
      "type": "string"
    },
    "notes_th": {
      "items": {
        "type": "string"
      },
      "title": "Notes Th",
      "type": "array"
    },
    "previous_report_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Day of the report the releases are compared with: the last one this site published before report_date, at most 3 days before it (GetDam gives only the latest day; the Bangkok update does not run every day). Null when there is none",
      "title": "Previous Report Date"
    },
    "report_date": {
      "format": "date",
      "title": "Report Date",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_url": {
      "title": "Source Url",
      "type": "string"
    }
  },
  "required": [
    "fetched_at",
    "report_date",
    "source_url",
    "credit_th",
    "location_credit_th",
    "dams",
    "notes_th"
  ],
  "title": "DamReport",
  "type": "object"
}
