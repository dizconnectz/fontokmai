{
  "$defs": {
    "BankMeasurement": {
      "additionalProperties": false,
      "properties": {
        "bank_datum": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bank Datum"
        },
        "bank_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bank M"
        },
        "bank_side": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bank Side"
        },
        "credit_th": {
          "minLength": 1,
          "title": "Credit Th",
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/BankPointGeometry"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "measurement",
          "title": "Kind",
          "type": "string"
        },
        "level_datum": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Level Datum"
        },
        "level_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Level M"
        },
        "level_side": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Level Side"
        },
        "name_th": {
          "minLength": 1,
          "title": "Name Th",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed At"
        },
        "source_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "verified": {
          "description": "Source quality control passed and evidence scope checked by producer",
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name_th",
        "observed_at",
        "verified",
        "source_url",
        "credit_th",
        "kind",
        "geometry",
        "level_m",
        "bank_m",
        "level_datum",
        "bank_datum",
        "level_side",
        "bank_side"
      ],
      "title": "BankMeasurement",
      "type": "object"
    },
    "BankPointGeometry": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "additionalItems": false,
          "items": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            }
          ],
          "maxItems": 2,
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "Point",
          "default": "Point",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "BankPointGeometry",
      "type": "object"
    },
    "BankReachGeometry": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "additionalItems": false,
            "items": [
              {
                "maximum": 180,
                "minimum": -180,
                "type": "number"
              },
              {
                "maximum": 90,
                "minimum": -90,
                "type": "number"
              }
            ],
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "LineString",
          "default": "LineString",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "BankReachGeometry",
      "type": "object"
    },
    "BankReachReport": {
      "additionalProperties": false,
      "properties": {
        "credit_th": {
          "minLength": 1,
          "title": "Credit Th",
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/BankReachGeometry"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "reported_reach",
          "title": "Kind",
          "type": "string"
        },
        "name_th": {
          "minLength": 1,
          "title": "Name Th",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed At"
        },
        "source_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "status": {
          "description": "Explicit source observation for this exact reach, never extrapolated from one gauge",
          "enum": [
            "above_bank",
            "at_bank",
            "below_bank",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "verified": {
          "description": "Source quality control passed and evidence scope checked by producer",
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name_th",
        "observed_at",
        "verified",
        "source_url",
        "credit_th",
        "kind",
        "geometry",
        "status"
      ],
      "title": "BankReachReport",
      "type": "object"
    },
    "CanalStation": {
      "additionalProperties": false,
      "properties": {
        "canal_th": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Canal Th"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "district_th": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "District Th"
        },
        "level_in_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Water level on the inner side (ระดับน้ำด้านใน), metres above mean sea level (ม.รทก.), not the depth of water on a road",
          "title": "Level In M"
        },
        "level_out_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Water level on the outer side (ระดับน้ำด้านนอก), m above MSL",
          "title": "Level Out M"
        },
        "location": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "[lon, lat]; null when DXS gives none or it lies outside the Bangkok area",
          "title": "Location"
        },
        "name_th": {
          "description": "Station name as DXS gives it, e.g. ส.คลองเตย (ส. = pumping station, ปตร. = water gate, ค. = canal gauge)",
          "title": "Name Th",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Time of the latest reading (Thai time)",
          "title": "Observed At"
        },
        "previous_level_in_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inner level of the reading before this one, as the site published it (at most 24 hours earlier), to tell rising from falling; null when there is none. Compared by this site, not by the department (2026-10-03)",
          "title": "Previous Level In M"
        },
        "previous_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Time of that earlier reading (Thai time); null with previous_level_in_m",
          "title": "Previous Observed At"
        },
        "pumps": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Number of pumps, for a pumping station",
          "title": "Pumps"
        },
        "pumps_running": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pumps running at the reading (pumpdata true); null when the station gives no pump status. A count of pumps, not a drainage capacity",
          "title": "Pumps Running"
        }
      },
      "required": [
        "code",
        "name_th",
        "canal_th",
        "district_th",
        "location",
        "observed_at",
        "level_in_m",
        "level_out_m",
        "pumps"
      ],
      "title": "CanalStation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bank_observations": {
      "description": "Optional verified bank-level evidence. DXS currently supplies none: keep empty, never invent banks or reaches. Register rights and evidence coverage before enabling a source. Consumers expire at 60 minutes.",
      "items": {
        "discriminator": {
          "mapping": {
            "measurement": "#/$defs/BankMeasurement",
            "reported_reach": "#/$defs/BankReachReport"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/BankMeasurement"
          },
          {
            "$ref": "#/$defs/BankReachReport"
          }
        ]
      },
      "title": "Bank Observations",
      "type": "array"
    },
    "credit_th": {
      "title": "Credit Th",
      "type": "string"
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "notes_th": {
      "items": {
        "type": "string"
      },
      "title": "Notes Th",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_url": {
      "description": "Public page of the department to link out to (never a DXS page)",
      "title": "Source Url",
      "type": "string"
    },
    "stations": {
      "description": "Every station DXS lists, sorted by code",
      "items": {
        "$ref": "#/$defs/CanalStation"
      },
      "title": "Stations",
      "type": "array"
    }
  },
  "required": [
    "fetched_at",
    "source_url",
    "credit_th",
    "stations",
    "notes_th"
  ],
  "title": "CanalLevels",
  "type": "object"
}
